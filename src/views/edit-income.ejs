<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Income</title>
    <link rel="stylesheet" href="/style/style.css" />
  </head>
  <body>
    <h1>Edit Income</h1>
    <form action="/edit-income/<%= income._id %>" method="POST">
      <label for="beschrijving">Description:</label>
      <input
        type="text"
        id="beschrijving"
        name="beschrijving"
        value="<%= income.beschrijving %>"
        required
      /><br /><br />

      <label for="bedrag">Amount:</label>
      <input
        type="number"
        id="bedrag"
        name="bedrag"
        value="<%= income.bedrag %>"
        required
      /><br /><br />

      <label for="datum">Date:</label>
      <input
        type="datetime-local"
        id="datum"
        name="datum"
        value="<%= income.datum.toISOString().slice(0, 16) %>"
        required
      /><br /><br />

      <label for="valuta">Currency:</label>
      <input
        type="text"
        id="valuta"
        name="valuta"
        value="<%= income.valuta %>"
        required
      /><br /><br />

      <label for="categorie">Category:</label>
      <input
        type="text"
        id="categorie"
        name="categorie"
        value="<%= income.categorie %>"
        required
      /><br /><br />

      <button type="submit">Update Income</button>
    </form>
    <a href="/">Back to Home</a>
  </body>
</html>
